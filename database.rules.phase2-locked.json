{
  "__comment": "FAZ-2 KILIT KURALI — HENUZ DEPLOY ETME. Yalnizca su kosullar saglaninca uygula: (1) Faz-1+davet penceresi iceren uygulama surumu kullanicilara yayildi ve (2) aktif cihazlar bir sure calisip vaults/$vaultId/members/$uid kayitlarini olusturdu. O zaman bu dosyanin icerigini database.rules.json'a kopyalayip 'firebase deploy --only database' calistir. Farki: .read/.write artik 'yalnizca uye' (+ davet penceresi). Bu deploy edilince vaultId sizinti riski (Bulgu 1) tamamen kapanir. Bu '__comment' alanini kopyalarken silebilirsin; Firebase yok sayar ama gereksizdir.",
  "rules": {
    ".read": false,
    ".write": false,
    "config": {
      ".read": true,
      ".write": false,
      "minVersionCode":    { ".validate": "newData.isNumber()" },
      "latestVersionCode": { ".validate": "newData.isNumber()" },
      "$other":            { ".validate": false }
    },
    "vaults": {
      "$vaultId": {
        ".read": "auth != null && data.child('members').child(auth.uid).exists()",
        ".write": "auth != null && (!data.child('members').exists() || data.child('members').child(auth.uid).exists() || (data.child('openUntil').isNumber() && now < data.child('openUntil').val()))",
        "members": {
          "$uid": { ".validate": "$uid === auth.uid && newData.isBoolean()" }
        },
        "openUntil": { ".validate": "newData.isNumber()" },
        "transactions": {
          "$txId": {
            ".validate": "newData.hasChildren(['type','assetType','date','amount','unitPrice','createdAt'])",
            "type":       { ".validate": "newData.isString()" },
            "assetType":  { ".validate": "newData.isString()" },
            "date":       { ".validate": "newData.isString()" },
            "amount":     { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "unitPrice":  { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "note":       { ".validate": "newData.isString() && newData.val().length <= 2000" },
            "createdAt":  { ".validate": "newData.isString()" },
            "fxSnapshot": {
              ".validate": "newData.hasChildren(['USD','EUR'])",
              "USD":    { ".validate": "newData.isNumber() && newData.val() > 0" },
              "EUR":    { ".validate": "newData.isNumber() && newData.val() > 0" },
              "$other": { ".validate": false }
            },
            "$other":     { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
